APP_NAME=Oudaa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------
# Aiven free MySQL. Get these from the Aiven console -> your service ->
# "Overview" tab (Host/Port/User/Password/Database) — Aiven's default
# database is usually named "defaultdb", not "oudaa".
DB_CONNECTION=mysql
DB_HOST=your-service-name.aivencloud.com
DB_PORT=your-port
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=

# Required for Aiven: download ca.pem from the same Overview page and
# put it somewhere the app can read at runtime (e.g. storage/certs/aiven-ca.pem,
# gitignored — never commit it). Aiven's free MySQL refuses non-TLS
# connections, so this isn't optional.
DB_MYSQL_SSL_CA=/absolute/path/to/aiven-ca.pem

DB_FOREIGN_KEYS=true

# Local dev without touching Aiven: DB_CONNECTION=sqlite (see config/database.php),
# no other vars below this line needed in that case.

# --- Queue ----------------------------------------------------------------
# Tenant provisioning (creating a settings row + sending an email) now
# runs inline instead of being dispatched to a background worker, so
# there's no second process to run. If signup volume or the provisioning
# job ever grows heavy enough to want it off the request thread again,
# switch this to 'database' and run `php artisan queue:work` as a
# second process — but that's a scaling decision to make later, not a
# default this app needs today.
QUEUE_CONNECTION=sync

# --- Mail (fill in once you send over your SMTP details) ------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=support@oudaa.com
MAIL_FROM_NAME="${APP_NAME}"

# Where public contact-form submissions get sent.
MAIL_SUPPORT_ADDRESS=support@oudaa.com

# --- Session ----------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
