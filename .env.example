APP_NAME=Oudaa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------
# Central: the one fixed registry DB (tenants, queue jobs). Never changes.
DB_CENTRAL_DATABASE=/absolute/path/to/database/central.sqlite

# Tenant: placeholder only, used outside real HTTP requests (artisan,
# queue worker boot). Overwritten per-request by ResolveTenant middleware.
DB_TENANT_PLACEHOLDER=/absolute/path/to/database/tenants/_placeholder.sqlite

DB_FOREIGN_KEYS=true

# When ready to move off SQLite, point DB_CONNECTION at 'mysql' and fill
# these in — connection *names* used throughout the app ('central',
# 'tenant') don't need to change, just what driver backs them.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=oudaa
# DB_USERNAME=root
# DB_PASSWORD=

# --- Queue ----------------------------------------------------------------
# Tenant provisioning runs in the background. Requires a worker running:
#   php artisan queue:work --queue=default
QUEUE_CONNECTION=database

# --- Mail (fill in once you send over your SMTP details) ------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=support@oudaa.com
MAIL_FROM_NAME="${APP_NAME}"

# Where public contact-form submissions get sent.
MAIL_SUPPORT_ADDRESS=support@oudaa.com

# --- Session ----------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
